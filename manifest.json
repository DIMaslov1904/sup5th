{
  "manifest_version": 3,
  "name": "SUP 5th",
  "short_name": "SUP5th",
  "version": "4.0.2",
  "description": "Ассистент 5th: проекты и доступы, SEO-анализ страниц и интеграция с тикетами поддержки",
  "homepage_url": "https://github.com/DIMaslov1904",
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": [
        "src/content-script/index.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_idle"
    },
    {
      "all_frames": false,
      "js": [
        "src/content-script/seo.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "src/content-script/support.js"
      ],
      "matches": [
        "https://support.5th.ru/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "resources": [
        "src/content-script/index.js"
      ]
    }
  ],
  "icons": {
    "16": "src/assets/icons/icon_16.png",
    "19": "src/assets/icons/icon_19.png",
    "32": "src/assets/icons/icon_32.png",
    "38": "src/assets/icons/icon_38.png",
    "48": "src/assets/icons/icon_48.png",
    "64": "src/assets/icons/icon_64.png",
    "128": "src/assets/icons/icon_128.png"
  },
  "options_page": "src/options/index.html",
  "permissions": [
    "storage",
    "offscreen",
    "webRequest",
    "downloads",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "script-src": "self",
    "object-src": "self"
  }
}
