{
  "manifest_version": 3,
  "name": "SUP 5th",
  "short_name": "SUP5th",
  "version": "1.1.0",
  "description": "Ассистент 5th: проекты и доступы, автовход в админки, SEO-анализ страниц и интеграция с тикетами поддержки",
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": [
        "src/content-script/index.js"
      ],
      "matches": [
        "*://*/*"
      ],
      "run_at": "document_idle"
    },
    {
      "all_frames": true,
      "js": [
        "src/content-script/seo.js"
      ],
      "matches": [
        "*://*/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "src/content-script/support.js"
      ],
      "matches": [
        "https://support.5th.ru/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://*/*"
      ],
      "resources": [
        "src/content-script/index.js"
      ]
    }
  ],
  "icons": {
    "16": "src/assets/icons/icon_16.png",
    "32": "src/assets/icons/icon_32.png",
    "64": "src/assets/icons/icon_64.png",
    "128": "src/assets/icons/icon_128.png"
  },
  "options_page": "src/options/index.html",
  "omnibox": {
    "keyword": "sup"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_security_policy": {
    "script-src": "self",
    "object-src": "self"
  }
}
