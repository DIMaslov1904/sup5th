{
  "manifest_version": 3,
  "name": "SUP 5th",
  "short_name": "SUP5th",
  "version": "4.0.2",
  "description": "Ассистент 5th: проекты и доступы, SEO-анализ страниц и интеграция с тикетами поддержки",
  "homepage_url": "https://github.com/DIMaslov1904",
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "src/content-script/support.js"
      ],
      "matches": [
        "https://support.5th.ru/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "src/assets/icons/icon_16.png",
    "19": "src/assets/icons/icon_19.png",
    "32": "src/assets/icons/icon_32.png",
    "38": "src/assets/icons/icon_38.png",
    "48": "src/assets/icons/icon_48.png",
    "64": "src/assets/icons/icon_64.png",
    "128": "src/assets/icons/icon_128.png"
  },
  "options_page": "src/options/index.html",
  "permissions": [
    "storage",
    "offscreen",
    "webRequest",
    "downloads",
    "alarms",
    "tabs",
    "scripting",
    "activeTab",
    "idle"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://accounts.google.com/*",
    "https://support.5th.ru/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "minimum_chrome_version": "130"
}
